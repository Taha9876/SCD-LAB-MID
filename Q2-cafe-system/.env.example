# FastBite runtime secrets - this file is a template only.
#   cp .env.example .env     then replace the values below in .env
# .env is ignored by Git (.gitignore) and by Docker (.dockerignore), so the real
# password never reaches GitHub or an image. Use letters, digits and hyphens only
# in the password, because it is placed inside a MongoDB connection URL.
MONGO_ROOT_USERNAME=fastbite_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

# Optional overrides
# GATEWAY_PORT=3000
# TAG=latest
# IMAGE_PREFIX=ghcr.io/taha9876/fastbite
