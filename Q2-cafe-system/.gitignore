.env
.env.*
!.env.example
*.pem
*.key

# Logs and process-manager runtime files
logs/
*.log
npm-debug.log*
.pm2/
*.pid

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
coverage/
